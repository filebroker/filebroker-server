proxy_cache_path /data/nginx/thumb_cache
    keys_zone=thumb_cache:${FILEBROKER_THUMB_CACHE_KEYS_ZONE_SIZE}
    loader_threshold=300
    loader_files=200
    max_size=${FILEBROKER_THUMB_CACHE_MAX_SIZE}
    inactive=1y;

limit_req_zone $binary_remote_addr zone=default:10m rate=50r/s;
limit_req_zone $binary_remote_addr zone=search:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=2r/s;

limit_req_status 429;
limit_conn_status 429;

resolver 127.0.0.11 valid=10s ipv6=off;

upstream filebroker_api {
    zone filebroker_api 64k;

    ${FILEBROKER_API_UPSTREAMS}
}

server {
    listen 80;
    listen [::]:80;

    server_name _;

    access_log /var/log/nginx/access.log;

    root /usr/share/nginx/html;

    location ${FILEBROKER_BASE_PATH}/api/upload/ {
        limit_req zone=default burst=100 delay=50;

        client_max_body_size 64G;
        proxy_request_buffering off;

        proxy_pass http://filebroker_api/upload/;
    }

    location ^~ ${FILEBROKER_BASE_PATH}/api/get-object/thumb_ {
        limit_req zone=default burst=100 delay=50;

        proxy_pass http://filebroker_api/get-object/thumb_;

        proxy_cache_key $uri;
        proxy_cache thumb_cache;
        proxy_cache_valid 200 1y;

        add_header X-Cache-Status $upstream_cache_status;
    }

    location ${FILEBROKER_BASE_PATH}/api/get-object/ {
        limit_req zone=default burst=100 delay=50;

        proxy_buffering off;

        proxy_pass http://filebroker_api/get-object/;
    }

    location ~ ^${FILEBROKER_BASE_PATH}/api/register/?(.*)$ {
        limit_req zone=auth burst=5 delay=2;

        proxy_pass http://filebroker_api/register/$1$is_args$args;
    }

    location ~ ^${FILEBROKER_BASE_PATH}/api/login/?(.*)$ {
        limit_req zone=auth burst=5 delay=2;

        proxy_pass http://filebroker_api/login/$1$is_args$args;
    }

    location ~ ^${FILEBROKER_BASE_PATH}/api/search/?(.*)$ {
        limit_req zone=search burst=50 delay=10;

        proxy_pass http://filebroker_api/search/$1$is_args$args;
    }

    location ${FILEBROKER_BASE_PATH}/api/ {
        limit_req zone=default burst=100 delay=50;

        proxy_pass http://filebroker_api/;
    }

    location ${FILEBROKER_BASE_PATH}/ {
        alias /usr/share/nginx/html/filebroker/;

        index index.html index.htm;

        try_files $uri $uri/ ${FILEBROKER_BASE_PATH}/index.html;
    }

    location = /404.html {
        internal;
    }
}
